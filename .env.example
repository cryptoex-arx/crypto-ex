# Copy this file to `.env` (and optionally `.env.development` / `.env.production`)
# and fill in the values for your machine. Never commit real secrets.

# Logical environment name, surfaced through src/config/env.ts.
APP_ENV=development

# Base URL of the backend API (no trailing slash).
API_BASE_URL=https://api.example.com

# Network timeout for API requests, in milliseconds.
API_TIMEOUT_MS=15000
